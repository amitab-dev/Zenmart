{
  "name": "zenmart",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist",
    "start": "export NODE_ENV=production && bun run ./dist/index.js",
    "clean": "rm -rf node_modules dist",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "db:push": "bunx drizzle-kit push"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.1"
  }
}